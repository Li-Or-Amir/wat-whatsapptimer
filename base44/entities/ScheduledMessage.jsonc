{
  "name": "ScheduledMessage",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "Reference to the contact"
    },
    "contact_name": {
      "type": "string",
      "description": "Contact name for quick display"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone for sending"
    },
    "message": {
      "type": "string",
      "description": "Message content to send"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time",
      "description": "When to send the message"
    },
    "timezone": {
      "type": "string",
      "description": "Timezone for the scheduled time"
    },
    "attachments": {
      "type": "array",
      "description": "Attached files, images, GIFs, stickers",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "pending_user_action",
        "sent",
        "failed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Current status of the message"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Actual time when message was sent"
    }
  },
  "required": [
    "contact_id",
    "message",
    "scheduled_time"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}